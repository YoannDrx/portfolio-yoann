# ==========================================
# Transport du formulaire de contact
# ==========================================

# Bascule manuelle uniquement : "resend" ou "yodev_mail".
# Il n'existe aucun fallback automatique afin d'éviter les doubles envois.
CONTACT_EMAIL_PROVIDER="resend"

# Adresses communes aux deux transports.
CONTACT_EMAIL="hello@yoann-andrieux.fr"
CONTACT_FROM_EMAIL="portfolio-yoann@yodev.fr"

# Mail by Yodev : clé serveur limitée à emails:send et template approuvé.
YODEV_MAIL_API_URL="https://api.mail.yodev.fr"
YODEV_MAIL_API_KEY="ym_test_xxxxx"
YODEV_MAIL_TEMPLATE_ID="00000000-0000-0000-0000-000000000000"

# Rollback Resend conservé pendant le canari.
RESEND_API_KEY="re_xxxxx"

# ==========================================
# Configuration avancée (optionnel)
# ==========================================

# Domaine partagé vérifié sur Resend.
RESEND_FROM_EMAIL="Portfolio Yoann <portfolio-yoann@yodev.fr>"

# ==========================================
# Notes importantes
# ==========================================
#
# Le domaine yodev.fr doit être vérifié dans Resend (SPF/DKIM).
# Les réponses utilisent l'adresse saisie par le visiteur via Reply-To.
