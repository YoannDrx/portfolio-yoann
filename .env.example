# ==========================================
# Configuration Resend (envoi d'emails)
# ==========================================

# Clé API Resend (obligatoire)
# Obtenir une clé sur https://resend.com/api-keys
RESEND_API_KEY="re_xxxxx"

# Email de destination (alias redirigé et libellé dans Gmail)
CONTACT_EMAIL="hello@yoann-andrieux.fr"

# ==========================================
# Configuration avancée (optionnel)
# ==========================================

# Domaine partagé vérifié sur Resend.
RESEND_FROM_EMAIL="Portfolio Yoann <portfolio-yoann@yodev.fr>"

# ==========================================
# Notes importantes
# ==========================================
#
# Le domaine yodev.fr doit être vérifié dans Resend (SPF/DKIM).
# Les réponses utilisent l'adresse saisie par le visiteur via Reply-To.
