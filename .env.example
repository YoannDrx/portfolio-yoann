# ==========================================
# Configuration Resend (envoi d'emails)
# ==========================================

# Clé API Resend (obligatoire)
# Obtenir une clé sur https://resend.com/api-keys
RESEND_API_KEY="re_xxxxx"

# Email de destination (où tu reçois les messages)
# Par défaut: yoann.andrieux@gmail.com
CONTACT_EMAIL="ton@email.com"

# ==========================================
# Configuration avancée (optionnel)
# ==========================================

# Email d'envoi personnalisé (nécessite un domaine vérifié sur Resend)
# Par défaut: "Portfolio <onboarding@resend.dev>" (domaine de test)
# Exemple avec domaine perso: "Contact <contact@yoann-andrieux.fr>"
# RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ==========================================
# Notes importantes
# ==========================================
#
# Avec le domaine de test (onboarding@resend.dev):
# - Aucune configuration DNS nécessaire
# - Les emails ne peuvent être envoyés QU'À l'email vérifié de ton compte Resend
# - Parfait pour un portfolio (les visiteurs t'envoient des messages)
#
# Avec un domaine personnalisé:
# - Nécessite configuration DNS (SPF, DKIM, DMARC)
# - Peut envoyer à n'importe quelle adresse
# - Plus professionnel (pas de "via resend.dev")
# - Guide: https://resend.com/docs/dashboard/domains/introduction
